# Redis (BullMQ)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# 프로젝트 루트 (Android Termux 등)
PROJECT_ROOT=/storage/emulated/0/Projects/motiondot

# 아래 경로는 PROJECT_ROOT 기준 (상대) 또는 절대 경로
TEMP_DIR=temp
OUTPUT_DIR=outputs
PRESETS_DIR=presets

# Free tier 정책
FREE_TIER_MAX_BATCH_JOBS=3
FREE_TIER_MAX_WIDTH=1280
FREE_TIER_MAX_HEIGHT=720
FREE_TIER_WATERMARK_TEXT=MotionDot Free

# Analytics (PostHog — 선택, 없으면 localStorage만 사용)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# free | pro — template_exported.watermarked 추정용 (기본 free)
NEXT_PUBLIC_MOTIONDOT_TIER=free
