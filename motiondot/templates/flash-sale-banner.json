{
  "id": "flash-sale-banner",
  "name": "Flash Sale Banner",
  "description": "플래시 세일 배너 — 텍스트 모션 중심",
  "category": "promo",
  "durationSec": 3,
  "fps": 24,
  "width": 1200,
  "height": 628,
  "aspectRatio": "1.91:1",
  "loop": true,
  "layout": {
    "background": {
      "kind": "none",
      "animation": "fade",
      "timing": {
        "startFrame": 0,
        "durationFrames": 90
      },
      "position": {
        "x": "0",
        "y": "0",
        "width": "100%",
        "height": "100%"
      },
      "objectFit": "cover"
    },
    "headline": {
      "defaultText": "FLASH SALE",
      "animation": "shake",
      "timing": {
        "startFrame": 0,
        "durationFrames": 40
      },
      "position": {
        "x": "8%",
        "y": "72%",
        "width": "84%"
      }
    },
    "subline": {
      "defaultText": "24시간 한정",
      "animation": "slide-up",
      "timing": {
        "startFrame": 8,
        "durationFrames": 35
      },
      "position": {
        "x": "8%",
        "y": "72%",
        "width": "84%"
      }
    },
    "cta": {
      "defaultText": "지금 쇼핑",
      "animation": "glow",
      "timing": {
        "startFrame": 15,
        "durationFrames": 30
      },
      "position": {
        "x": "50%",
        "y": "85%"
      },
      "borderRadius": 12
    },
    "badge": {
      "defaultText": "LIMITED",
      "animation": "loop-pulse",
      "timing": {
        "startFrame": 5,
        "durationFrames": 80
      },
      "position": {
        "x": "8%",
        "y": "8%"
      }
    }
  },
  "timeline": [
    {
      "id": "bg",
      "layer": "background",
      "startFrame": 0,
      "durationFrames": 150,
      "animation": "fade"
    },
    {
      "id": "head",
      "layer": "headline",
      "startFrame": 10,
      "durationFrames": 50,
      "animation": "slide-up"
    },
    {
      "id": "cta",
      "layer": "cta",
      "startFrame": 25,
      "durationFrames": 40,
      "animation": "pop"
    }
  ],
  "theme": {
    "primary": "#f59e0b",
    "secondary": "#a78bfa",
    "text": "#ffffff",
    "ctaBackground": "#f59e0b",
    "ctaText": "#ffffff",
    "overlay": "rgba(0,0,0,0.45)"
  },
  "typography": {
    "headline": {
      "fontSize": 56,
      "fontWeight": 900
    },
    "subline": {
      "fontSize": 24,
      "fontWeight": 500,
      "lineHeight": 1.3
    },
    "cta": {
      "fontSize": 18,
      "fontWeight": 700
    },
    "badge": {
      "fontSize": 14,
      "fontWeight": 700
    }
  }
}
