      "objectFit": "cover"
    },
    "headline": {
      "defaultText": "구매 전 이것만 확인",
      "animation": "slide-up",
      "timing": { "startFrame": 8, "durationFrames": 45 },
      "position": { "x": "8%", "y": "58%", "width": "84%" }
    },
    "subline": {
      "defaultText": "체크리스트 3가지",
      "animation": "fade",
      "timing": { "startFrame": 16, "durationFrames": 40 },
