  "timeline": [
    { "id": "bg", "layer": "background", "startFrame": 0, "durationFrames": 150, "animation": "fade" },
    { "id": "head", "layer": "headline", "startFrame": 8, "durationFrames": 50, "animation": "slide-up" },
    { "id": "cta", "layer": "cta", "startFrame": 22, "durationFrames": 45, "animation": "pop" }
  ],
  "theme": {
    "primary": "#7c3aed",
    "secondary": "#a78bfa",
    "text": "#ffffff",
    "ctaBackground": "#7c3aed",
    "ctaText": "#ffffff",
