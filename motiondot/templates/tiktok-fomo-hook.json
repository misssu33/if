{
  "id": "tiktok-fomo-hook",
  "name": "FOMO Hook",
  "description": "모르면 손해·긴급 훅 — TikTok 제휴 9:16",
  "category": "promo",
  "targetPlatform": "tiktok",
  "affiliateCategory": "모르면 손해",
  "marketTier": "primary",
  "recommendedPresetId": "tiktok-short-clip",
  "durationSec": 4,
  "fps": 30,
  "width": 1080,
  "height": 1920,
  "aspectRatio": "9:16",
  "loop": true,
  "layout": {
    "background": {
      "kind": "video",
      "animation": "fade",
      "timing": { "startFrame": 0, "durationFrames": 120 },
      "position": { "x": "0", "y": "0", "width": "100%", "height": "100%" },
      "objectFit": "cover"
    },
    "product": {
      "kind": "image",
      "animation": "shake",
      "timing": { "startFrame": 5, "durationFrames": 90 },
      "position": { "x": "0", "y": "0", "width": "100%", "height": "100%" },
      "objectFit": "cover"
    },
    "headline": {
      "defaultText": "모르면 손해",
      "animation": "pop",
      "timing": { "startFrame": 6, "durationFrames": 40 },
      "position": { "x": "8%", "y": "58%", "width": "84%" }
    },
    "subline": {
      "defaultText": "지금 안 보면 후회",
      "animation": "fade",
      "timing": { "startFrame": 14, "durationFrames": 35 },
      "position": { "x": "8%", "y": "66%", "width": "84%" }
    },
    "cta": {
      "defaultText": "바로 보기",
      "animation": "pop",
      "timing": { "startFrame": 20, "durationFrames": 35 },
      "position": { "x": "50%", "y": "86%" },
      "borderRadius": 12
    },
    "badge": {
      "defaultText": "FOMO",
      "animation": "loop-pulse",
      "timing": { "startFrame": 4, "durationFrames": 100 },
      "position": { "x": "8%", "y": "6%" }
    }
  },
  "timeline": [
    { "id": "bg", "layer": "background", "startFrame": 0, "durationFrames": 120, "animation": "fade" },
    { "id": "head", "layer": "headline", "startFrame": 6, "durationFrames": 45, "animation": "pop" },
    { "id": "cta", "layer": "cta", "startFrame": 20, "durationFrames": 40, "animation": "pop" }
  ],
  "theme": {
    "primary": "#dc2626",
    "secondary": "#f97316",
    "text": "#ffffff",
    "ctaBackground": "#dc2626",
    "ctaText": "#ffffff",
    "overlay": "rgba(0,0,0,0.5)"
  },
  "typography": {
    "headline": { "fontSize": 50, "fontWeight": 900, "lineHeight": 1.05 },
    "subline": { "fontSize": 24, "fontWeight": 600, "lineHeight": 1.25 },
    "cta": { "fontSize": 18, "fontWeight": 700 },
    "badge": { "fontSize": 14, "fontWeight": 700 }
  }
}
