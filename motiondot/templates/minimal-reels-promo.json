{
  "id": "minimal-reels-promo",
  "name": "Minimal Reels Promo",
  "description": "미니멀 릴스·스토리 프로모 — 세로 9:16",
  "category": "lifestyle",
  "targetPlatform": "reels",
  "recommendedPresetId": "instagram-reels",
  "durationSec": 4,
  "fps": 30,
  "width": 1080,
  "height": 1920,
  "aspectRatio": "9:16",
  "loop": true,
  "layout": {
    "background": {
      "kind": "video",
      "animation": "fade",
      "timing": { "startFrame": 0, "durationFrames": 120 },
      "position": { "x": "0", "y": "0", "width": "100%", "height": "100%" },
      "objectFit": "cover"
    },
    "headline": {
      "defaultText": "오늘의 딜",
      "animation": "fade",
      "timing": { "startFrame": 8, "durationFrames": 40 },
      "position": { "x": "8%", "y": "60%", "width": "84%" }
    },
    "subline": {
      "defaultText": "프로필 링크에서 확인",
      "animation": "slide-up",
      "timing": { "startFrame": 14, "durationFrames": 35 },
      "position": { "x": "8%", "y": "68%", "width": "84%" }
    },
    "cta": {
      "defaultText": "보러가기",
      "animation": "fade",
      "timing": { "startFrame": 20, "durationFrames": 35 },
      "position": { "x": "50%", "y": "86%" },
      "borderRadius": 24
    },
    "badge": {
      "defaultText": "NEW",
      "animation": "fade",
      "timing": { "startFrame": 5, "durationFrames": 100 },
      "position": { "x": "8%", "y": "6%" }
    }
  },
  "timeline": [
    { "id": "bg", "layer": "background", "startFrame": 0, "durationFrames": 120, "animation": "fade" },
    { "id": "head", "layer": "headline", "startFrame": 8, "durationFrames": 45, "animation": "fade" },
    { "id": "cta", "layer": "cta", "startFrame": 20, "durationFrames": 40, "animation": "fade" }
  ],
  "theme": {
    "primary": "#e1306c",
    "secondary": "#f77737",
    "text": "#ffffff",
    "ctaBackground": "rgba(255,255,255,0.95)",
    "ctaText": "#18181b",
    "overlay": "rgba(0,0,0,0.28)"
  },
  "typography": {
    "headline": { "fontSize": 44, "fontWeight": 700, "lineHeight": 1.1 },
    "subline": { "fontSize": 22, "fontWeight": 400, "lineHeight": 1.35 },
    "cta": { "fontSize": 16, "fontWeight": 600 },
    "badge": { "fontSize": 12, "fontWeight": 600 }
  }
}
