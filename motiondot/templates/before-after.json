{
  "id": "before-after",
  "name": "Before / After",
  "description": "비포·애프터 비교 광고",
  "category": "comparison",
  "durationSec": 6,
  "fps": 30,
  "width": 1080,
  "height": 1080,
  "aspectRatio": "1:1",
  "loop": true,
  "layout": {
    "background": {
      "kind": "image",
      "animation": "fade",
      "timing": {
        "startFrame": 0,
        "durationFrames": 90
      },
      "position": {
        "x": "0",
        "y": "0",
        "width": "100%",
        "height": "100%"
      },
      "objectFit": "cover"
    },
    "product": {
      "kind": "image",
      "animation": "slide-up",
      "timing": {
        "startFrame": 30,
        "durationFrames": 60
      },
      "position": {
        "x": "0",
        "y": "0",
        "width": "100%",
        "height": "100%"
      },
      "objectFit": "cover"
    },
    "headline": {
      "defaultText": "BEFORE → AFTER",
      "animation": "zoom",
      "timing": {
        "startFrame": 8,
        "durationFrames": 50
      },
      "position": {
        "x": "8%",
        "y": "72%",
        "width": "84%"
      }
    },
    "subline": {
      "defaultText": "실사용 후기",
      "animation": "fade",
      "timing": {
        "startFrame": 20,
        "durationFrames": 35
      },
      "position": {
        "x": "8%",
        "y": "72%",
        "width": "84%"
      }
    },
    "cta": {
      "defaultText": "결과 확인",
      "animation": "pop",
      "timing": {
        "startFrame": 25,
        "durationFrames": 35
      },
      "position": {
        "x": "50%",
        "y": "85%"
      },
      "borderRadius": 12
    },
    "badge": {
      "defaultText": "비교",
      "animation": "loop-pulse",
      "timing": {
        "startFrame": 5,
        "durationFrames": 80
      },
      "position": {
        "x": "8%",
        "y": "8%"
      }
    }
  },
  "timeline": [
    {
      "id": "bg",
      "layer": "background",
      "startFrame": 0,
      "durationFrames": 150,
      "animation": "fade"
    },
    {
      "id": "head",
      "layer": "headline",
      "startFrame": 10,
      "durationFrames": 50,
      "animation": "slide-up"
    },
    {
      "id": "cta",
      "layer": "cta",
      "startFrame": 25,
      "durationFrames": 40,
      "animation": "pop"
    }
  ],
  "theme": {
    "primary": "#7c3aed",
    "secondary": "#a78bfa",
    "text": "#ffffff",
    "ctaBackground": "#7c3aed",
    "ctaText": "#ffffff",
    "overlay": "rgba(0,0,0,0.45)"
  },
  "typography": {
    "headline": {
      "fontSize": 48,
      "fontWeight": 800,
      "lineHeight": 1.1
    },
    "subline": {
      "fontSize": 24,
      "fontWeight": 500,
      "lineHeight": 1.3
    },
    "cta": {
      "fontSize": 18,
      "fontWeight": 700
    },
    "badge": {
      "fontSize": 14,
      "fontWeight": 700
    }
  }
}
